generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique @db.VarChar(200)
  password_hash String      @db.VarChar(255)
  name          String?     @db.VarChar(200)
  role          String      @default("user") @db.VarChar(20)
  status        String      @default("pending") @db.VarChar(20)
  theme         String      @default("dark") @db.VarChar(10)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  audit_logs    AuditLog[]

  @@map("users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(50)
  resource    String   @db.VarChar(100)
  resource_id String?  @db.VarChar(100)
  details     String?  @db.Text
  ip          String?  @db.VarChar(45)
  created_at  DateTime @default(now())

  @@map("audit_logs")
}

model Site {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(200)
  url               String           @db.VarChar(500)
  health_check_url  String           @db.VarChar(500)
  environment       String           @db.VarChar(20) // "dev" | "tst" | "stg" | "prd"
  status            String           @default("unknown") @db.VarChar(20)
  last_checked      DateTime?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  health_logs       HealthCheckLog[]

  @@map("sites")
}

model HealthCheckLog {
  id          Int      @id @default(autoincrement())
  site_id     Int
  site        Site     @relation(fields: [site_id], references: [id], onDelete: Cascade)
  status      String   @db.VarChar(20)
  status_code Int?
  latency     Int?
  error       String?  @db.Text
  created_at  DateTime @default(now())

  @@map("health_check_logs")
}

